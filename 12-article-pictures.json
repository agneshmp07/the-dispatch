    {
      "id": "592a0ea3-6b46-4746-8b6a-56ecb3e29e07",
      "name": "Fetch article pages",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        100
      ],
      "parameters": {
        "url": "={{ $json.url }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0 Safari/537.36"
            },
            {
              "name": "Accept-Language",
              "value": "en-IN,en;q=0.9"
            }
          ]
        },
        "options": {
          "timeout": 10000,
          "batching": {
            "batch": {
              "batchSize": 6,
              "batchInterval": 300
            }
          },
          "redirect": {
            "redirect": {
              "maxRedirects": 5
            }
          },
          "response": {
            "response": {
              "responseFormat": "text",
              "neverError": true,
              "outputPropertyName": "data"
            }
          }
        }
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "id": "ea3a0d38-709f-4b2d-ba23-5c302743cf6d",
      "name": "Find pictures",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        100
      ],
      "parameters": {
        "jsCode": "// Find each article's own picture: the og:image / twitter:image the publisher set for sharing\nconst asked = $('Articles without pictures').all().map((i) => i.json);\nconst pages = $input.all().map((i) => i.json);\nconst meta = (html, prop) => {\n  const m = html.match(new RegExp(`<meta[^>]+(?:property|name)=[\"']${prop}[\"'][^>]*content=[\"']([^\"']+)[\"']`, 'i'))\n    || html.match(new RegExp(`<meta[^>]+content=[\"']([^\"']+)[\"'][^>]*(?:property|name)=[\"']${prop}[\"']`, 'i'));\n  return m ? m[1].replace(/&amp;/g, '&').trim() : '';\n};\nconst out = asked.map((a, i) => {\n  const p = pages[i] || {};\n  const html = typeof p.data === 'string' ? p.data.slice(0, 300000) : '';\n  let img = html ? (meta(html, 'og:image:secure_url') || meta(html, 'og:image') || meta(html, 'twitter:image') || meta(html, 'twitter:image:src')) : '';\n  if (img.startsWith('//')) img = 'https:' + img;\n  else if (img.startsWith('/')) { const host = (String(a.url).match(/^https?:\\/\\/[^/]+/i) || [''])[0]; img = host ? host.replace(/^http:/i, 'https:') + img : ''; }\n  img = img.replace(/^http:\\/\\//i, 'https://');\n  return { id: a.id, image: /^https:\\/\\/\\S+$/i.test(img) ? img : '' };\n});\nreturn [{ json: { b64: Buffer.from(JSON.stringify(out), 'utf8').toString('base64'), found: out.filter((x) => x.image).length, tried: out.length } }];\n"
      }
    },
    {
      "id": "efaa6d63-3b81-4f71-a41d-f4d791966594",
      "name": "Save pictures",
      "type": "n8n-nodes-base.postgres",
