      "position": [
        960,
        100
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT save_article_images($1) AS r;",
        "options": {
          "queryReplacement": "={{ $json.b64 }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "REPLACE_PG",
          "name": "Dispatch Postgres"
        }
      }
    }
  ],
