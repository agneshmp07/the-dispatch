    },
    {
      "id": "cf75de3a-4c6c-4879-861c-87e642cc6a79",
      "name": "Tell Shreya?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        1300
      ],
      "parameters": {
        "jsCode": "// Ping Shreya about the first few reader suggestions each day (the rest wait for \"suggestions\")\nconst esc = (v) => String(v == null ? '' : v).replace(/[&<>\"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;' }[c]));\nconst { r, cfg } = $input.first().json;\nif (!r || !r.ok || !r.notify || !r.suggestion || !cfg.telegram_chat_id) return [];\nconst sg = r.suggestion;\nreturn [{ json: { method: 'sendMessage', body: { chat_id: cfg.telegram_chat_id, parse_mode: 'HTML', link_preview_options: { is_disabled: true },\n  text: `📮 <b>Reader suggestion #${sg.id}</b>${sg.name ? ` from ${esc(sg.name)}` : ''}\\n<a href=\"${esc(sg.url)}\">${esc(sg.title || sg.url)}</a>` +\n    (sg.note ? `\\n“${esc(sg.note)}”` : '') +\n    `\\n\\nType <b>take ${sg.id}</b> to add it to the next draft, or <b>skip ${sg.id}</b>.` +\n    (r.open_count > 1 ? ` (${r.open_count} waiting: send <b>suggestions</b>)` : '') } } }];\n"
      }
    },
    {
      "id": "5394790f-ea4f-4bb5-bfad-1c600068f6ee",
      "name": "Tell Shreya",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        1300
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $('Save suggestion').first().json.cfg.telegram_bot_token }}/{{ $json.method }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 350
            }
          },
          "response": {
            "response": {
              "neverError": true
            }
          },
          "timeout": 20000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    }
  ],
  "connections": {
