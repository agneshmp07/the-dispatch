      "id": "04ef8b35-4371-4546-8fe5-13c1090dba15",
      "name": "Suggest a story",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        1200
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "dispatch-suggest",
        "responseMode": "responseNode",
        "options": {
