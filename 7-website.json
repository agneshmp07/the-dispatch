    {
      "id": "39bf0b16-3e02-4dc5-bce0-eb1556df5d71",
      "name": "Load news",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        220,
        1440
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT jsonb_build_object('updated', now(), 'week_count', (SELECT count(*) FROM articles WHERE week_start = d_week_start(d_now()) AND status <> 'duplicate' AND NOT coalesce(demo, false)), 'items', coalesce((SELECT jsonb_agg(jsonb_build_object('title', s.title, 'url', s.url, 'source', s.source_name, 'image', s.image_url, 'at', s.fetched_at) ORDER BY s.rk) FROM (SELECT a.*, row_number() OVER (ORDER BY a.week_start DESC, (a.image_url IS NOT NULL) DESC, a.fetched_at DESC) AS rk FROM articles a WHERE a.week_start >= d_week_start(d_now()) - 7 AND a.status <> 'duplicate' AND NOT coalesce(a.demo, false) AND length(a.title) > 12 ORDER BY rk LIMIT 24) s), '[]'::jsonb)) AS r;",
        "options": {}
      },
