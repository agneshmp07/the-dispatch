          "name": "Dispatch Postgres"
        }
      }
    },
    {
      "id": "3d37474b-48fc-444c-b495-8ec92ba05b36",
      "name": "Reply suggestion",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1100,
        1100
      ],
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ JSON.stringify({ ok: $json.r.ok, message: $json.r.message }) }}",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Access-Control-Allow-Origin",
                "value": "*"
              },
              {
                "name": "Content-Type",
                "value": "application/json; charset=utf-8"
