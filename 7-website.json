    {
      "id": "0002252f-177a-49b5-a91f-5b343b76417f",
      "name": "Check suggestion",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        1200
      ],
      "parameters": {
        "jsCode": "// Reader suggestion from the website form: tidy the input and decide whether the link is safe to fetch\nlet b = $input.first().json.body;\nif (typeof b === 'string') { try { b = JSON.parse(b); } catch (e) { b = {}; } }\nb = b || {};\nconst clip = (v, n) => String(v == null ? '' : v).replace(/[\\u0000-\\u001f]+/g, ' ').trim().slice(0, n);\nconst s = { url: clip(b.url, 600), note: clip(b.note, 400), name: clip(b.name, 80), email: clip(b.email, 200), website: clip(b.website, 100) };\nlet fetch_url = 'about:blank';\n// (no URL class in the n8n sandbox, so parse by hand) only public http(s) pages by name:\n// no IP literals, no user:pass@, no odd ports, no local or internal hosts\nconst m = s.url.match(/^(https?):\\/\\/([a-z0-9.-]+)(?::(\\d+))?([\\/?#][^\\s]*)?$/i);\nif (m) {\n  const host = m[2].toLowerCase(), port = m[3];\n  const ipLike = /^[0-9.]+$/.test(host);\n  const local = /(^|\\.)(localhost|local|internal|lan|home|corp)$/.test(host) || !host.includes('.');\n  if (!ipLike && !local && (!port || port === '80' || port === '443')) fetch_url = s.url;\n}\nif (s.website) fetch_url = 'about:blank';            // honeypot filled: don't bother fetching\nreturn [{ json: { s, fetch_url } }];\n"
      }
    },
    {
      "id": "5ae692ef-5803-48d5-93c5-ad5f3f0d70b2",
      "name": "Fetch suggested page",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        1200
      ],
      "parameters": {
        "url": "={{ $json.fetch_url }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0 Safari/537.36"
            }
          ]
        },
        "options": {
          "timeout": 8000,
          "redirect": {
            "redirect": {
              "maxRedirects": 4
            }
          },
          "response": {
            "response": {
              "responseFormat": "text",
              "neverError": true,
              "outputPropertyName": "data"
            }
          }
        }
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "id": "7da32756-4a86-4d33-96c5-1fd21a5332c5",
      "name": "Read page title",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        1200
      ],
      "parameters": {
        "jsCode": "// Pull the page title so Shreya sees a headline, not just a link\nconst { s } = $('Check suggestion').first().json;\nconst page = $input.first().json || {};\nconst html = typeof page.data === 'string' ? page.data.slice(0, 200000) : '';\nconst ENT = { '&amp;': '&', '&lt;': '<', '&gt;': '>', '&quot;': '\"', '&#39;': \"'\", '&#039;': \"'\", '&rsquo;': \"'\", '&lsquo;': \"'\", '&ldquo;': '\"', '&rdquo;': '\"', '&nbsp;': ' ', '&ndash;': '-', '&mdash;': '-', '&#8217;': \"'\", '&#8216;': \"'\", '&#8220;': '\"', '&#8221;': '\"', '&#x27;': \"'\" };\nconst decode = (t) => t.replace(/&[#a-z0-9]+;/gi, (m) => ENT[m.toLowerCase()] || ' ');\nconst meta = (prop) => {\n  const m = html.match(new RegExp(`<meta[^>]+(?:property|name)=[\"']${prop}[\"'][^>]*content=[\"']([^\"']+)[\"']`, 'i'))\n    || html.match(new RegExp(`<meta[^>]+content=[\"']([^\"']+)[\"'][^>]*(?:property|name)=[\"']${prop}[\"']`, 'i'));\n  return m ? m[1] : '';\n};\nlet title = meta('og:title') || meta('twitter:title') || ((html.match(/<title[^>]*>([\\s\\S]*?)<\\/title>/i) || [])[1] || '');\ntitle = decode(title.replace(/<[^>]+>/g, ' ')).replace(/\\s+/g, ' ').trim().slice(0, 300);\nif (!title) {\n  // the site blocked us: make a readable headline from the link itself (\"meesho-shares-surge-5\" -> \"Meesho shares surge 5\")\n  const segs = s.url.replace(/[?#].*$/, '').split('/').filter((x) => /[a-z]-[a-z]/i.test(x));\n  const slug = segs.sort((x, y) => y.length - x.length)[0] || '';\n  const words = slug.replace(/\\.[a-z]+$/i, '').replace(/[-_]+/g, ' ').replace(/\\b\\d{6,}\\b/g, '').trim();\n  if (words) title = (words.charAt(0).toUpperCase() + words.slice(1)).slice(0, 200);\n}\nconst b64 = Buffer.from(JSON.stringify(Object.assign({}, s, { title })), 'utf8').toString('base64');\nreturn [{ json: { b64 } }];\n"
      }
    },
    {
      "id": "d06efeec-4ea0-4062-a8ef-a4bd2f48a78b",
      "name": "Save suggestion",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        880,
        1200
      ],
      "parameters": {
        "operation": "executeQuery",
