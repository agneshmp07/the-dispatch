      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT url FROM articles WHERE week_start = d_week_start(d_now()) AND NOT coalesce(pinned,false) AND status = 'new' AND url NOT LIKE '%news.google.com%' ORDER BY fetched_at DESC LIMIT 1;",
        "options": {}
      },
