        "postgres": {
          "id": "REPLACE_PG",
          "name": "Dispatch Postgres"
        }
      },
      "alwaysOutputData": true
    },
    {
      "id": "fd71399f-c6b8-43d0-b236-e087fae41a3b",
      "name": "Build test messages",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        100
      ],
      "parameters": {
        "jsCode": "// Fake Telegram updates from Shreya's chat, posted to the bot's own webhook\nconst cfg = $('Load config').first().json.cfg;\nconst chat = Number(cfg.telegram_chat_id);\nconst link = ($('Pick a news link').first().json.url) || 'https://inc42.com/';\nconst base = Math.floor(Date.now() / 1000);\nconst texts = ['help', 'alternates', 'stats', link + ' self-test (auto-removed)'];\nreturn texts.map((text, i) => {\n  const isCmd = !text.startsWith('http');\n  const first = text.split(' ')[0];\n  return { json: { step: isCmd ? first : 'paste a link', body: {\n    update_id: base * 10 + i,\n    message: {\n      message_id: base * 10 + i, date: base,\n      chat: { id: chat, type: 'private' },\n      from: { id: chat, is_bot: false, first_name: 'Self-test' },\n      text,\n      entities: isCmd ? [] : [{ offset: 0, length: first.length, type: 'url' }],\n    } } } };\n});\n"
      }
    },
    {
      "id": "a864482e-5c6f-44f9-9fed-d9d94263d548",
      "name": "Send to bot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        800,
        100
      ],
      "parameters": {
        "method": "POST",
        "url": "https://newss.app.n8n.cloud/webhook/4e7c95b4-b915-454a-ba29-dde9fbe75159/webhook",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Telegram-Bot-Api-Secret-Token",
              "value": "ZZithGL5EkozfMME_1f5e0124-6d4f-49da-8d37-07a3db084e01"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 6000
            }
          },
          "response": {
            "response": {
              "neverError": true,
              "fullResponse": true
            }
          },
          "timeout": 20000
        }
      }
    },
    {
      "id": "3e6b7810-a507-42cd-aedd-c05aa299a5b9",
      "name": "Let the bot reply",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1000,
        100
