        "amount": 20
      },
      "webhookId": "d4b66902-0651-4a4e-8d79-0ca5430cf1fe"
    },
    {
      "id": "3d24b350-7436-48b6-9a4f-e1eca046446e",
      "name": "Unpin test link",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1200,
        100
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE articles SET pinned = false, pinned_note = null WHERE pinned AND pinned_note ILIKE '%self-test%' RETURNING id;",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "REPLACE_PG",
          "name": "Dispatch Postgres"
        }
      },
      "alwaysOutputData": true,
      "executeOnce": true
    },
    {
      "id": "3000fb95-3ce8-4c5e-8ef4-872dad63bb0f",
      "name": "Build report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1400,
        100
      ],
      "parameters": {
        "jsCode": "// Summarise the run and send it to Shreya\nconst cfg = $('Load config').first().json.cfg;\nconst sent = $('Send to bot').all().map((x, i) => ({\n  step: $('Build test messages').all()[i].json.step,\n  ok: String(x.json.statusCode || '').startsWith('2'),\n  code: x.json.statusCode,\n}));\nconst pinned = $('Unpin test link').all().filter((x) => x.json.id).length > 0;\nconst lines = sent.map((s) => `${s.ok ? '✅' : '❌'} ${s.step}${s.ok ? '' : ` (HTTP ${s.code})`}`);\nlines.push(`${pinned ? '✅' : '❌'} pasted link was pinned for the next draft${pinned ? ' (and removed again)' : ''}`);\nconst allOk = sent.every((s) => s.ok) && pinned;\nconst text = `🧪 <b>Self-test ${allOk ? 'passed' : 'found a problem'}</b>\\n\\n${lines.join('\\n')}\\n\\n` +\n  (allOk ? 'Every reply above came from the live bot.' : 'Something did not respond. The error alert, if any, will follow in this chat.');\nreturn [{ json: { method: 'sendMessage', body: { chat_id: cfg.telegram_chat_id, text, parse_mode: 'HTML' } } }];\n"
      }
    },
    {
      "id": "13b5f5d4-c6d9-48da-ad0d-a853bac46503",
      "name": "Send report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1600,
        100
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $('Load config').first().json.cfg.telegram_bot_token }}/{{ $json.method }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 350
            }
          },
          "response": {
            "response": {
              "neverError": true
            }
          },
          "timeout": 20000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    }
